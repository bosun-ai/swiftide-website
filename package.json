{
  "name": "swiftide-website",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "lint:idents": "node scripts/lint-identifiers.ts",
    "check:snippets": "cd snippets && cargo check --locked --all-targets",
    "verify:dist": "node scripts/verify-dist.ts",
    "verify": "pnpm test && pnpm lint:idents && pnpm check:snippets && astro check && pnpm build && pnpm verify:dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/starlight": "0.42.8",
    "@expressive-code/plugin-collapsible-sections": "0.44.3",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "astro": "7.4.5",
    "hast-util-select": "6.0.4",
    "mdast-util-directive": "3.2.0",
    "mdast-util-mdx-jsx": "3.2.1",
    "mdast-util-to-hast": "13.2.1",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "sharp": "0.35.5",
    "starlight-links-validator": "0.27.0",
    "starlight-llm-actions": "0.13.0",
    "starlight-llms-txt": "0.12.0",
    "unified": "11.0.5",
    "unist-util-remove": "4.0.0",
    "unist-util-visit": "5.2.0",
    "vfile": "6.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "@vscode/ripgrep": "1.18.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "description": "Source of swiftide.rs, the documentation site for the Swiftide Rust library."
}
