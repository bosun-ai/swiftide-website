---
/**
 * One showcase in `<Showcase>`: the code excerpt (the slot, a `::snippet`) on a square plate, and
 * beside it the showcase's name, one sentence, one line of its recorded output and two actions.
 *
 * `result` must be a line the showcase's OUTPUT.md really printed; the build fails otherwise.
 */
import { readFileSync } from 'node:fs';
import path from 'node:path';

interface Props {
	/** Tab label: the part of swiftide this shows (Agents, Tasks, Pipelines). */
	label: string;
	title: string;
	/** Directory under vendor/swiftide/examples; also the showcase page's slug. */
	example: string;
	description: string;
	/** One line of the recorded run. */
	result: string;
	/** The guide for this part of swiftide. */
	guide: string;
}

const { label, title, example, description, result, guide } = Astro.props;

const recording = path.join(process.cwd(), 'vendor/swiftide/examples', example, 'OUTPUT.md');
if (!readFileSync(recording, 'utf8').includes(result)) {
	throw new Error(`<ShowcasePanel example="${example}">: "${result}" is not in ${recording}`);
}
const id = `showcase-${example}`;
---

<article class="sw-panel" id={id} data-tab-label={label} aria-labelledby={`${id}-title`}>
	<div class="sw-panel__plate" data-stagger style="--i:0">
		<slot />
	</div>
	<div class="sw-panel__side">
		<div class="sw-panel__text" data-stagger style="--i:1">
			<h2 class="sw-panel__title" id={`${id}-title`}>{title}</h2>
			<p class="sw-panel__description">{description}</p>
		</div>
		<p class="sw-panel__result" data-stagger style="--i:2"><code>{result}</code></p>
		<div class="sw-panel__actions" data-stagger style="--i:3">
			<a class="sw-cell" href={guide}>Read the guide</a>
			<a class="sw-cell sw-cell--ink" href={`/showcases/${example}/`}>Run it</a>
		</div>
	</div>
</article>
