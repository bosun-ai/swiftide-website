---
/**
 * Hero for splash pages (the home page and 404): a left-aligned mono headline and one supporting
 * sentence. On the home page the headline is set as its two authored lines (split after the colon)
 * and a metadata line shows the swiftide release the site documents; the stage, the action and
 * the install line come from `<HeroStage>` in the page body, which joins this hero's grid.
 */
import { loadSwiftideContext } from '../../lib/swiftide.ts';

// Starlight's page title id; the TOC and skip link point at it.
const PAGE_TITLE_ID = '_top';
const { entry } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline } = entry.data.hero ?? {};
const isHome = entry.id === 'index' || entry.id === '';
const swiftide = isHome ? loadSwiftideContext(process.cwd()) : undefined;
// "LLM applications in Rust: swift to build, built to ship." -> two lines, broken after the colon.
const lines = isHome ? title.split(/(?<=:)\s+/) : [title];
---

<div class="sw-hero" data-page={isHome ? 'home' : entry.id}>
	{
		isHome ? (
			<h1 id={PAGE_TITLE_ID} data-page-title class="sw-hero__lines">
				{lines.map((line, i) => (
					<span class="sw-hero__line">
						{line}
						{i < lines.length - 1 ? ' ' : ''}
					</span>
				))}
			</h1>
		) : (
			<h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
		)
	}
	{tagline && <p class="sw-hero__tagline" set:html={tagline} />}
	{
		swiftide && (
			<p class="sw-hero__meta">
				<span>swiftide {swiftide.version}</span>
				<span>rust</span>
				<span>MIT</span>
			</p>
		)
	}
</div>
